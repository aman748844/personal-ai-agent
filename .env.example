# ==========================================
# AI Agent Platform Configuration
# ==========================================

# 1. Server / Cloud Gateway Settings (AWS EC2 / Server)
PORT=4000
NODE_ENV=production
AGENT_SECRET=ai-agent-platform-secure-key-2026
VAULT_SECRET=local-pc-master-passphrase-2026

# 2. AI Brain LLM Providers (Optional - built-in smart planner works without keys)
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# 3. Client / Local Agent Settings (Used by any computer connecting to AWS)
# Replace with your AWS EC2 Public IP or Domain, e.g. ws://13.233.xx.xx:4000/agent
GATEWAY_WS_URL=ws://localhost:4000/agent
DEVICE_ID=my_laptop
DEVICE_TOKEN=device_token_my_laptop
